# Copiar este archivo como ".env" dentro de la carpeta backend
# y completar los valores. El archivo ".env" no se sube a GitHub.

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dona_laura_db
DB_USER=postgres
DB_PASSWORD=escribir_la_clave_de_postgres

# Asistente de IA (OpenAI)
OPENAI_API_KEY=escribir_la_clave_de_openai

# Opcional: modelo que usa el asistente. Si se deja comentado,
# se usa el modelo por defecto definido en ia/agente_llm.py
# OPENAI_MODEL=

# Opcional: ruta de un CSV con los datos reales de cosecha (con nombres).
# Si se deja comentado, se usa el CSV de ejemplo con trabajadores anonimizados
# (ia/dataset_cosecha_paltas_2026.csv).
# DATASET_PATH=C:/ruta/al/dataset_real.csv
